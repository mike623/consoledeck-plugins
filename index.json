      "platforms": [],
      "files": [
        "plugin.json"
      ],
      "commands": []
    },
    {
      "id": "system",
      "name": "System",
      "version": "1.0.0",
      "description": "Lock, sleep, volume, input language, log out, restart and shut down.",
      "platforms": [],
      "files": [
        "plugin.json"
      ],
      "commands": [
        [
          "rundll32.exe",
          "user32.dll,LockWorkStation"
        ],
        [
          "/usr/bin/pmset",
          "sleepnow"
        ],
        [
          "rundll32.exe",
          "powrprof.dll,SetSuspendState",
          "0,1,0"
        ],
        [
          "/usr/bin/pmset",
          "displaysleepnow"
        ],
        [
          "powershell",
          "-NoProfile",
          "-Command",
          "(Add-Type '[DllImport(\"user32.dll\")]public static extern int SendMessage(int h,int m,int w,int l);' -Name W -PassThru)::SendMessage(0xffff,0x0112,0xF170,2)"
        ],
        [
          "/usr/bin/open",
          "-a",
          "ScreenSaverEngine"
        ],
        [
          "scrnsave.scr",
          "/s"
        ],
        [
          "/usr/bin/osascript",
          "-e",
          "tell application \"loginwindow\" to «event aevtlogo»"
        ],
        [
          "shutdown",
          "/l"
        ],
        [
          "/usr/bin/osascript",
          "-e",
          "tell application \"loginwindow\" to «event aevtrrst»"
        ],
        [
          "shutdown",
          "/r",
          "/t",
          "15"
        ],
        [
          "/usr/bin/osascript",
          "-e",
          "tell application \"loginwindow\" to «event aevtrsdn»"
        ],
        [
          "shutdown",
          "/s",
          "/t",
          "15"
        ]
      ]
    },
    {
