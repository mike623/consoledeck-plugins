    {
      "id": "vpn",
      "name": "Toggle VPN",
      "version": "1.0.0",
      "description": "Connects a Tunnelblick (OpenVPN) configuration, or disconnects it when it's up.",
      "platforms": [
        "mac"
      ],
      "files": [
        "configs.sh",
        "import.sh",
        "plugin.json",
        "toggle.sh"
      ],
      "commands": [
        [
          "/bin/bash",
          "./toggle.sh",
          "{config}"
        ],
        [
          "/bin/bash",
          "./configs.sh"
        ],
        [
          "/bin/bash",
          "./import.sh",
          "{file}"
        ]
      ]
    }
  ]
